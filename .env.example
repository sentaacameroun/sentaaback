# Django
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=sentaaback.onrender.com,localhost
CORS_ALLOWED_ORIGINS=https://votre-frontend.example.com

# Base de données PostgreSQL
# POSTGRES_HOST/PORT ci-dessous ne servent QUE si tu lances Django directement sur l'hôte
# (hors docker-compose) ou sur Render. Sous docker-compose*.yml, web/celery_* utilisent
# toujours db:5432 en dur (voir ces fichiers) — POSTGRES_HOST/PORT y sont ignorés.
POSTGRES_DB=sentaa
POSTGRES_USER=
POSTGRES_PASS=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# docker-compose.yml (dev local) uniquement : ports hôte, à changer si déjà pris sur ta machine
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
WEB_HOST_PORT=8000

# Déploiement VPS (docker-compose.prod.yml / docker-compose.staging.yml)
# NB : ALLOWED_HOSTS est fixé par le compose selon l'environnement (api.sentaa.net en prod,
# dev.sentaa.net en staging) ; la valeur ALLOWED_HOSTS ci-dessus ne sert qu'en dev local.
# NB : sous compose, seul POSTGRES_PASSWORD est requis (mappé vers POSTGRES_PASS côté Django).
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=4
# Flower (monitoring Celery) — auth basique, accès via tunnel SSH uniquement (port loopback).
FLOWER_USER=admin
FLOWER_PASSWORD=change-me
# Optionnel : créé automatiquement au premier démarrage du conteneur web (entrypoint.sh),
# idempotent (ignoré silencieusement si déjà existant). Laisser vide pour créer le superuser
# manuellement via `docker compose exec web python manage.py createsuperuser`.
DJANGO_SUPERUSER_PHONE_NUMBER=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=Senta'a

# django-axes (protection brute-force login admin)
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1

# Fournisseur Mobile Money actif : "kpay" (intégrateur principal) ou "notchpay" (historique,
# conservé en architecture multi-provider — voir escrow/services/providers/).
PAYMENT_PROVIDER=kpay

# KPay (https://kpay.site/documentation) — clés générées depuis le dashboard, écran
# "Applications".
KPAY_BASE_URL=https://admin.kpay.site
KPAY_API_KEY=
KPAY_SECRET_KEY=
# Secret HMAC-SHA256 du webhook KPay (dashboard, en-tête X-KPAY-Signature). Vide = signature
# non vérifiée (la re-vérification via l'API reste la mitigation).
KPAY_WEBHOOK_SECRET=

# NotchPay (Mobile Money : MTN MoMo + Orange Money Cameroun) — fournisseur historique.
NOTCHPAY_BASE_URL=https://api.notchpay.co
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
# "Webhook hash" NotchPay (dashboard) : vérifie la signature x-notch-signature du webhook.
# Vide = signature non vérifiée (la re-vérification via l'API reste la mitigation).
NOTCHPAY_WEBHOOK_HASH=
# Réconciliation des reversements bloqués (escrow/tasks.py)
PAYOUT_RECONCILIATION_MINUTES=30
PAYOUT_RECONCILIATION_MAX_ATTEMPTS=5
# Réconciliation/reprise des collectes bloquées (escrow/tasks.py, initiate_payment)
COLLECT_RECONCILIATION_MINUTES=30
COLLECT_RECONCILIATION_MAX_ATTEMPTS=5

# SMS OTP : "console" (dev, log local) ou "twilio" (prod, envoi réel)
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stockage média S3 (optionnel : sans ces valeurs, fallback sur disque local) — fichiers non
# image uniquement (CV en PDF). Les images passent par Cloudinary, voir plus bas.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=

# Cloudinary (stockage des images : logos, icônes, photos d'annonces, pièce d'identité
# coursier). Créer un compte gratuit sur https://cloudinary.com puis récupérer ces 3 valeurs
# dans le Dashboard. Sans elles, tout upload d'image échouera (400/502).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Organisation uniquement (voir back_sentaa/settings.py) — laisser la valeur par défaut sauf
# besoin explicite de distinguer plusieurs environnements sur un même compte Cloudinary.
CLOUDINARY_FOLDER_PREFIX=sentaa

# Firebase Cloud Messaging (push notifications, notifications/). Contenu JSON COMPLET du
# compte de service (Firebase Console > Paramètres du projet > Comptes de service > Générer
# une nouvelle clé privée) — PAS un chemin de fichier : aucun fichier de credentials à
# déposer sur le serveur. Compacter le JSON sur une seule ligne avant de le coller ici
# (ex. `jq -c . service-account.json`), et NE PAS entourer la valeur de guillemets : sous
# docker-compose (env_file: .env), les guillemets sont pris littéralement et cassent le JSON.
# Vide = envoi push désactivé (notifications/services/push.py lève explicitement si un envoi
# est tenté sans credentials).
GOOGLE_APPLICATION_CREDENTIALS=

# HSTS (uniquement appliqué si DEBUG=False)
SECURE_HSTS_SECONDS=2592000

# Email (rappels + newsletter, notifications/) : sans EMAIL_HOST, backend "console" (log local)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@senta-a.com

# URL absolue du backend (emails : logo statique, lien de désinscription newsletter) — doit
# rester cohérente avec ALLOWED_HOSTS.
BACKEND_PUBLIC_URL=https://sentaaback.onrender.com
# Pied de page email newsletter (mention légale anti-spam CAN-SPAM/RGPD)
COMPANY_POSTAL_ADDRESS=Douala, Cameroun

# Seuils des rappels Celery (notifications/tasks.py)
ESCROW_PENDING_REMINDER_HOURS=24
RECEPTION_REMINDER_DAYS=3
APPLICATION_REMINDER_DAYS=5
